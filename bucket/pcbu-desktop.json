            "hash": "8dd13fd25981da092f9b56409009257230b3f69cdca546d90b98a03e462bbdfb",
            "pre_install": [
                "Expand-InnoArchive \"$dir\\PulseUnlock-Setup-x64.exe\" \"$dir\" -Removal",
                "if (Test-Path \"$dir\\{app}\") { Move-Item \"$dir\\{app}\\*\" \"$dir\" -Force; Remove-Item \"$dir\\{app}\" -Recurse -Force }"
            ]
        },
        "arm64": {
            "url": "https://github.com/MeisApps/pcbu-desktop/releases/download/v4.1.0/PulseUnlock-Setup-arm64.exe",
            "hash": "0a615c3566e1deab45aa2ced6c9859b2767f3fe38f9283929265e5e7cabba4e9",
            "pre_install": [
                "Expand-InnoArchive \"$dir\\PulseUnlock-Setup-arm64.exe\" \"$dir\" -Removal",
                "if (Test-Path \"$dir\\{app}\") { Move-Item \"$dir\\{app}\\*\" \"$dir\" -Force; Remove-Item \"$dir\\{app}\" -Recurse -Force }"
            ]
        }
    },
    "bin": "pcbu_desktop.exe",
    "shortcuts": [
