          "to": "AIMP-ContextMenu.ini"
        },
        {
          "from": "AIMP-CustomGenres.txt",
          "to": "AIMP-CustomGenres.txt"
        },
        {
          "from": "AIMP.ini",
          "to": "AIMP.ini"
        },
        {
          "from": "AIMPac.ini",
          "to": "AIMPac.ini"
        },
        {
          "from": "AIMPate.ini",
          "to": "AIMPate.ini"
