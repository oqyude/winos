{
  "version": 2,
  "persistRoot": "$persist",
  "symlinks": [
    {
      "name": "AIMP",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name",
      "mappings": [
        { "from": "AudioLibrary", "to": "AudioLibrary" },
        { "from": "Skins", "to": "Skins" },
        { "from": "aimp_scheduler.xml", "to": "aimp_scheduler.xml" },
        { "from": "aimp_scrobbler.xml", "to": "aimp_scrobbler.xml" },
        { "from": "AIMP-ContextMenu.ini", "to": "AIMP-ContextMenu.ini" },
        { "from": "AIMP-CustomGenres.txt", "to": "AIMP-CustomGenres.txt" },
        { "from": "AIMP.ini", "to": "AIMP.ini" },
        { "from": "AIMP.ini.bak", "to": "AIMP.ini.bak" },
        { "from": "AIMPac.ini", "to": "AIMPac.ini" },
        { "from": "AIMPate.ini", "to": "AIMPate.ini" },
        { "from": "AlbumArts.Cache.db", "to": "AlbumArts.Cache.db" },
        { "from": "CDDB.db", "to": "CDDB.db" },
        { "from": "Elevator.ini", "to": "Elevator.ini" },
        { "from": "EQPresetsLibrary.ini", "to": "EQPresetsLibrary.ini" }
      ]
    },
    {
      "name": "KeePassXC",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "ludusavi",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "Playnite",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "Powertoys",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:LOCALAPPDATA\\Microsoft\\PowerToys"
    },
    {
      "name": "SumatraPDF",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name\\SumatraPDF-settings.txt",
      "to": "$env:USERPROFILE\\scoop\\persist\\sumatrapdf\\SumatraPDF-settings.txt"
    },
    {
      "name": "Syncthing",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:LOCALAPPDATA\\$name"
    },
    {
      "name": "v2rayN",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:LOCALAPPDATA\\$name"
    },
    {
      "name": "VSCodium",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "EqualizerAPO",
      "archived": false,
      "enabled": true,
      "method": "isolate",
      "from": "$persist\\$name",
      "to": "$env:ProgramFiles\\$name"
    },
    {
      "name": "deemix",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name",
      "mappings": [
        { "from": "config.json", "to": "config.json" },
        { "from": "spotify\\config.json", "to": "spotify\\config.json" }
      ]
    },
    {
      "name": "Stretchly",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name\\config.json",
      "to": "$env:APPDATA\\$name\\config.json"
    },
    {
      "name": "SyncTrayzor",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "qBittorrent",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:USERPROFILE\\scoop\\persist\\qbittorrent-enhanced\\profile\\qBittorrent\\config"
    },
    {
      "name": "starhip.toml",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.config\\starship.toml",
      "to": "$env:USERPROFILE\\.config\\starship.toml"
    },
    {
      "name": "SSH",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.ssh",
      "to": "$env:USERPROFILE\\.ssh"
    },
    {
      "name": "bash_rc",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.bashrc",
      "to": "$env:USERPROFILE\\.bashrc"
    },
    {
      "name": "bash_inputrc",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.inputrc",
      "to": "$env:USERPROFILE\\.inputrc"
    },
    {
      "name": "bash_gitconfig",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.gitconfig",
      "to": "$env:USERPROFILE\\.gitconfig"
    },
    {
      "name": "wslconfig",
      "archived": false,
      "enabled": true,
      "from": "$storage\\home\\.wslconfig",
      "to": "$env:USERPROFILE\\.wslconfig"
    },
    {
      "name": "deploy-folder",
      "archived": false,
      "enabled": true,
      "from": "$root",
      "to": "$env:USERPROFILE\\Winos"
    },
    {
      "name": "storage-folder",
      "archived": false,
      "enabled": true,
      "from": "$root",
      "to": "$env:USERPROFILE\\Storage\\winos"
    }
  ]
}
