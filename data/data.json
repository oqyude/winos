{
  "version": 2,
  "persistRoot": "$persist",
  "symlinks": [
    {
      "name": "AIMP",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "AIMP",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name",
      "mappings": [
        { "from": "AudioLibrary", "to": "AudioLibrary" },
        { "from": "Skins", "to": "Skins" },
        { "from": "aimp_scheduler.xml", "to": "aimp_scheduler.xml" },
        { "from": "aimp_scrobbler.xml", "to": "aimp_scrobbler.xml" },
        { "from": "AIMP-ContextMenu.ini", "to": "AIMP-ContextMenu.ini" },
        { "from": "AIMP-CustomGenres.txt", "to": "AIMP-CustomGenres.txt" },
        { "from": "AIMP.ini", "to": "AIMP.ini" },
        { "from": "AIMP.ini.bak", "to": "AIMP.ini.bak" },
        { "from": "AIMPac.ini", "to": "AIMPac.ini" },
        { "from": "AIMPate.ini", "to": "AIMPate.ini" },
        { "from": "AlbumArts.Cache.db", "to": "AlbumArts.Cache.db" },
        { "from": "CDDB.db", "to": "CDDB.db" },
        { "from": "Elevator.ini", "to": "Elevator.ini" },
        { "from": "EQPresetsLibrary.ini", "to": "EQPresetsLibrary.ini" }
      ]
    },
    {
      "name": "KeePassXC",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "ludusavi",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "Playnite",
      "archived": true,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "Powertoys",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:LOCALAPPDATA\\Microsoft\\PowerToys"
    },
    {
      "name": "SumatraPDF",
      "archived": false,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:USERPROFILE\\scoop\\persist\\sumatrapdf",
      "mappings": [
        { "from": "SumatraPDF-settings.txt", "to": "SumatraPDF-settings.txt" }
      ]
    },
    {
      "name": "Syncthing",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:LOCALAPPDATA\\$name"
    },
    {
      "name": "v2rayN",
      "archived": true,
      "enabled": true,
      "from": "$persist\\$name",
      "to": "$env:LOCALAPPDATA\\$name"
    },
    {
      "name": "VSCodium",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "EqualizerAPO",
      "archived": true,
      "enabled": true,
      "method": "isolate",
      "from": "$persist\\$name",
      "to": "$env:ProgramFiles\\$name"
    },
    {
      "name": "deemix",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "Stretchly",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name\\config.json",
      "to": "$env:APPDATA\\$name\\config.json"
    },
    {
      "name": "SyncTrayzor",
      "archived": true,
      "enabled": true,
      "from": "$persist\\$name\\$env:COMPUTERNAME",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "qBittorrent",
      "archived": true,
      "enabled": false,
      "from": "$persist\\$name",
      "to": "$env:APPDATA\\$name"
    },
    {
      "name": "SSH",
      "archived": true,
      "enabled": false,
      "from": "$persist\\ssh",
      "to": "$env:USERPROFILE\\.ssh"
    },
    {
      "name": "bash_rc",
      "archived": true,
      "enabled": false,
      "from": "$persist\\User Folder\\.bashrc",
      "to": "$env:USERPROFILE\\.bashrc"
    },
    {
      "name": "bash_inputrc",
      "archived": true,
      "enabled": false,
      "from": "$persist\\User Folder\\.inputrc",
      "to": "$env:USERPROFILE\\.inputrc"
    },
    {
      "name": "bash_gitconfig",
      "archived": true,
      "enabled": false,
      "from": "$persist\\User Folder\\.gitconfig",
      "to": "$env:USERPROFILE\\.gitconfig"
    },
    {
      "name": "wslconfig",
      "archived": true,
      "enabled": false,
      "from": "$persist\\User Folder\\.wslconfig",
      "to": "$env:USERPROFILE\\.wslconfig"
    },
    {
      "name": "deploy-folder",
      "archived": true,
      "enabled": true,
      "from": "$root",
      "to": "$env:USERPROFILE\\Winos"
    },
    {
      "name": "continue",
      "archived": true,
      "enabled": false,
      "from": "$persist\\User Folder\\.continue",
      "to": "$env:USERPROFILE\\.continue"
    }
  ]
}
