<?xml version="1.0" encoding="UTF-8"?>
<!--
  The declaration of the "opencode serve" task.

  This file is the SOURCE OF TRUTH for the task: what runs it, when it runs,
  as whom, and in which folder. The scheduler module compares it with the
  live task and reports the difference; it never invents a task of its own.

  The file name is the task name. Task Scheduler addresses a task by the name
  of the file it was imported from, so the two have to agree.

  Placeholders (resolved per host by the scheduler module):

    __USER__       the account the task runs as, in Task Scheduler's
                   DOMAIN\user form
    __DATA_ROOT__  the winos data root; the launcher lives under it
    __TOOLS_DIR__  the host's tools directory
    __HOME__       the user's profile directory

  What the diff compares, and what it ignores, is documented in
  src/modules/scheduler/State.ps1. In short: who runs it, when it runs, what
  it runs and where. Everything else in the document is noise.

  THE LOGON TYPE is the field that drifted between the two hosts:
  InteractiveToken (this file) against S4U on the other one. InteractiveToken
  is the safe choice for a server that has to reach the network. An S4U task
  runs without stored credentials and may be denied network access. Change
  one line to move to the other mode.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>opencode serve on 0.0.0.0:4096, started from the winos task declaration.</Description>
    <URI>\OpenCodeServe</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER__</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <!--
        RunLevel in the vocabulary of the XML, not of the PowerShell cmdlet:
        Task Scheduler writes "LeastPrivilege" for what
        Register-ScheduledTask -RunLevel Limited means. Declaring "Limited"
        here would make every live task differ from the declaration on a
        field that says nothing.
      -->
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>5</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>bash</Command>
      <Arguments>"__DATA_ROOT__\tools\host-scripts\opencode-serve.sh"</Arguments>
      <WorkingDirectory>__DATA_ROOT__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
